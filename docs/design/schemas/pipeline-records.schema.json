          "type": "string",
          "enum": [
            "nachos_tier",
            "adjusted_band",
            "complexity_band",
            "threshold"
          ]
        },
        "value_key": {
          "type": "string"
        },
        "display_label": {
          "type": "string"
        },
        "description": {
          "$ref": "#/$defs/nullable_text"
        },
        "min_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "sort_order": {
